{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["worker", "db", "src/types.ts", "src/designFormat.ts"]
}
